{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "jsx": "preserve",
        "allowJs": true,
        "checkJs": false,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true
    },
    "include": ["src/**/*", "next-env.d.ts", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
