# ---------------------------------------------------------------------------
# Database — MySQL 8 / MariaDB 10.4+. Create the schema, then run
# `npx prisma db push` followed by `npm run db:seed`.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@127.0.0.1:3306/cma2"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME="CallMineAI"
APP_URL="http://localhost:3000"
APP_ENV=local
APP_DEBUG=false
APP_DEMO_MODE=false
APP_INSTALLED=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

NEXT_PUBLIC_APP_NAME="CallMineAI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain-root deployment: empty. Subdirectory deployment: /callmine.
# Must be configured BEFORE npm run build; basePath includes static asset URLs.
NEXT_PUBLIC_BASE_PATH=""

# ---------------------------------------------------------------------------
# Secrets — both are REQUIRED. The app refuses to sign or encrypt with an
# empty key, so set these before the first start.
# ---------------------------------------------------------------------------

# Signs the session cookies. Use 32+ random characters.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# REQUIRED. Encrypts every credential saved from the admin panel (Twilio,
# OpenAI, ElevenLabs, SMTP, payment gateways, SIP secrets) and signs the
# in-call agent's callback tokens. Generate one with:
#
#     npm run key:generate
#
# `npm run db:seed` also writes one automatically when this is still empty.
# Rotating it makes credentials stored under the old key unreadable — re-enter
# them from the admin panel after a rotation.
APP_KEY=

# Set to true only when your SMTP server presents a self-signed certificate.
# Leaving it false keeps TLS certificate validation on, as it should be.
MAIL_ALLOW_SELF_SIGNED=false

# ---------------------------------------------------------------------------
# Calling
# ---------------------------------------------------------------------------
CALL_CREDIT_PRICE_CENTS=10
CALL_VOICE_COST_CENTS=10
CALL_NUMBER_COST_CREDITS=50
CALL_PRO_BONUS_CREDITS=100
CALL_MAX_RETRIES=3
CALL_DIALER_CONCURRENCY=60
CALL_MAX_TURNS=12
CALL_REPLY_TIMEOUT=10
CALL_DEFAULT_LLM=gpt-4o-mini
CALL_DEFAULT_ENGINE=elevenlabs_twilio

# ---------------------------------------------------------------------------
# Telephony
# ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=twilio

TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_DEFAULT_FROM=
TWILIO_API_BASE=https://api.twilio.com
TWILIO_STATUS_CALLBACK_URL=
TWILIO_RECORDING_CALLBACK_URL=
TWILIO_INBOUND_VOICE_URL=
TWILIO_FALLBACK_VOICE=Polly.Matthew

PLIVO_ENABLED=true
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_DEFAULT_FROM=
PLIVO_API_BASE=https://api.plivo.com

# ---------------------------------------------------------------------------
# Voice (ElevenLabs)
# ---------------------------------------------------------------------------
ELEVENLABS_ENABLED=true
ELEVENLABS_API_BASE=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_MAX_CONCURRENCY=30
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_PREVIEW_TEXT="Hi, this is your AI calling agent. How can I help you today?"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
AI_OPENAI_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
AI_CREDITS_PER_GENERATION=10
AI_RATE_LIMIT_PER_MINUTE=20

# ---------------------------------------------------------------------------
# SIP
# ---------------------------------------------------------------------------
SIP_ENABLED=true
SIP_DEFAULT_ENGINE=elevenlabs

# ---------------------------------------------------------------------------
# Public REST API
# ---------------------------------------------------------------------------
API_ENABLED=true
API_DEFAULT_RATE_LIMIT=100
API_RATE_WINDOW_SECONDS=60
API_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Messaging (WhatsApp)
# ---------------------------------------------------------------------------
MESSAGING_ENABLED=true
WHATSAPP_PROVIDER_MODE=disabled
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_VERIFY_TOKEN=callmineai
META_GRAPH_VERSION=v21.0
WHATSWAY_BASE_URL=
WHATSWAY_API_KEY=

# ---------------------------------------------------------------------------
# Billing gateways
# ---------------------------------------------------------------------------
BILLING_STRIPE_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

BILLING_PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
PAYPAL_WEBHOOK_ID=

BILLING_PADDLE_ENABLED=false
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Mail (fallback when no smtp_configurations row is active)
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="CallMineAI"

# ---------------------------------------------------------------------------
# Seeded demo accounts (surfaced on the login page when APP_DEMO_MODE=true)
# ---------------------------------------------------------------------------
CLIENT_SEED_EMAIL=client@spagreen.net
CLIENT_SEED_PASSWORD=12345678
ADMIN_SEED_EMAIL=admin@spagreen.net
ADMIN_SEED_PASSWORD=12345678

# Landing footer store badges (optional)
APP_STORE_URL=
GOOGLE_PLAY_URL=
