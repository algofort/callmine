generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminRole {
  admin_user_id BigInt    @db.UnsignedBigInt
  role_id       BigInt    @db.UnsignedBigInt
  admin_users   AdminUser @relation(fields: [admin_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_role_admin_user_id_foreign")
  roles         Role      @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_role_role_id_foreign")

  @@id([admin_user_id, role_id])
  @@index([role_id], map: "admin_role_role_id_foreign")
  @@map("admin_role")
}

model AdminUser {
  id                   BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String               @db.VarChar(255)
  email                String               @unique(map: "admin_users_email_unique") @db.VarChar(255)
  password             String               @db.VarChar(255)
  status               String               @default("ACTIVE") @db.VarChar(20)
  remember_token       String?              @db.VarChar(100)
  created_at           DateTime?            @db.Timestamp(0)
  updated_at           DateTime?            @db.Timestamp(0)
  admin_role           AdminRole[]
  audit_logs           AuditLog[]
  client_subscriptions ClientSubscription[]
  credit_ledger        CreditLedger[]
  kyc_documents        KycDocument[]
  notifications        Notification[]

  @@map("admin_users")
}

model Agent {
  id                    BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  client_id             BigInt              @db.UnsignedBigInt
  user_id               BigInt?             @db.UnsignedBigInt
  name                  String              @db.VarChar(255)
  voice_id              BigInt?             @db.UnsignedBigInt
  language              String              @default("en") @db.VarChar(16)
  llm_model             String              @default("gpt-4o-mini") @db.VarChar(64)
  engine                String              @default("elevenlabs_twilio") @db.VarChar(40)
  temperature           Decimal             @default(0.7) @db.Decimal(2, 1)
  tone                  String?             @db.VarChar(64)
  personality           String?             @db.VarChar(64)
  system_prompt         String?             @db.LongText
  greeting              String?             @db.Text
  status                String              @default("draft") @db.VarChar(32)
  elevenlabs_agent_id   String?             @db.VarChar(255)
  cost_per_minute_cents Int                 @default(107) @db.UnsignedInt
  meta                  Json?
  created_at            DateTime?           @db.Timestamp(0)
  updated_at            DateTime?           @db.Timestamp(0)
  deleted_at            DateTime?           @db.Timestamp(0)
  clients               Client              @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "agents_client_id_foreign")
  users                 User?               @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "agents_user_id_foreign")
  voices                Voice?              @relation(fields: [voice_id], references: [id], onUpdate: NoAction, map: "agents_voice_id_foreign")
  appointments          Appointment[]
  call_queue_jobs       CallQueueJob[]
  calls                 Call[]
  campaigns             Campaign[]
  inbound_routes        InboundRoute[]
  knowledge_base_items  KnowledgeBaseItem[]
  phone_numbers         PhoneNumber[]
  website_widgets       WebsiteWidget[]

  @@index([client_id, status], map: "agents_client_status_idx")
  @@index([user_id], map: "agents_user_id_foreign")
  @@index([voice_id], map: "agents_voice_id_foreign")
  @@map("agents")
}

model AiRequest {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt    @db.UnsignedBigInt
  website_id   BigInt?   @db.UnsignedBigInt
  step         String?   @db.VarChar(64)
  prompt       String?   @db.Text
  response     String?   @db.LongText
  tokens_used  Int       @default(0) @db.UnsignedInt
  cost         Decimal   @default(0.000000) @db.Decimal(10, 6)
  credits_used Int       @default(1) @db.UnsignedInt
  status       String    @default("pending") @db.VarChar(32)
  job_id       String?   @db.VarChar(64)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  users        User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_requests_user_id_foreign")
  websites     Website?  @relation(fields: [website_id], references: [id], onUpdate: NoAction, map: "ai_requests_website_id_foreign")

  @@index([job_id], map: "ai_requests_job_id_index")
  @@index([user_id, created_at], map: "ai_requests_user_id_created_at_index")
  @@index([website_id], map: "ai_requests_website_id_foreign")
  @@map("ai_requests")
}

model ApiAuditLog {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  api_key_id  BigInt?   @db.UnsignedBigInt
  client_id   BigInt?   @db.UnsignedBigInt
  method      String    @db.VarChar(8)
  path        String    @db.VarChar(255)
  status_code Int?      @db.UnsignedSmallInt
  ip          String?   @db.VarChar(45)
  duration_ms Int?      @db.UnsignedInt
  request_id  String?   @db.VarChar(36)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  api_keys    ApiKey?   @relation(fields: [api_key_id], references: [id], onUpdate: NoAction, map: "api_audit_logs_api_key_id_foreign")
  clients     Client?   @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_audit_logs_client_id_foreign")

  @@index([api_key_id], map: "api_audit_logs_api_key_id_foreign")
  @@index([client_id, created_at], map: "api_audit_logs_client_id_created_at_index")
  @@map("api_audit_logs")
}

model ApiKey {
  id                 BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  client_id          BigInt        @db.UnsignedBigInt
  name               String        @db.VarChar(255)
  prefix             String        @unique(map: "api_keys_prefix_unique") @db.VarChar(16)
  key_hash           String        @db.VarChar(255)
  scopes             Json?
  ip_whitelist       Json?
  rate_limit_per_min Int           @default(100) @db.UnsignedInt
  last_used_at       DateTime?     @db.Timestamp(0)
  expires_at         DateTime?     @db.Timestamp(0)
  revoked_at         DateTime?     @db.Timestamp(0)
  created_by         BigInt?       @db.UnsignedBigInt
  created_at         DateTime?     @db.Timestamp(0)
  updated_at         DateTime?     @db.Timestamp(0)
  api_audit_logs     ApiAuditLog[]
  clients            Client        @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "api_keys_client_id_foreign")
  users              User?         @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "api_keys_created_by_foreign")

  @@index([client_id], map: "api_keys_client_id_foreign")
  @@index([created_by], map: "api_keys_created_by_foreign")
  @@map("api_keys")
}

model Appointment {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  client_id        BigInt    @db.UnsignedBigInt
  contact_id       BigInt?   @db.UnsignedBigInt
  agent_id         BigInt?   @db.UnsignedBigInt
  title            String    @db.VarChar(255)
  contact_name     String?   @db.VarChar(255)
  contact_phone    String?   @db.VarChar(255)
  contact_email    String?   @db.VarChar(255)
  scheduled_at     DateTime  @db.Timestamp(0)
  duration_minutes Int       @default(30) @db.UnsignedSmallInt
  status           String    @default("scheduled") @db.VarChar(255)
  source           String    @default("manual") @db.VarChar(255)
  notes            String?   @db.Text
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  agents           Agent?    @relation(fields: [agent_id], references: [id], onUpdate: NoAction, map: "appointments_agent_id_foreign")
  clients          Client    @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "appointments_client_id_foreign")
  contacts         Contact?  @relation(fields: [contact_id], references: [id], onUpdate: NoAction, map: "appointments_contact_id_foreign")

  @@index([agent_id], map: "appointments_agent_id_foreign")
  @@index([client_id, status], map: "appointments_client_id_status_index")
  @@index([contact_id], map: "appointments_contact_id_foreign")
  @@map("appointments")
}

model AuditLog {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  actor_admin_id BigInt?    @db.UnsignedBigInt
  user_id        BigInt?    @db.UnsignedBigInt
  client_id      BigInt?    @db.UnsignedBigInt
  action         String     @db.VarChar(64)
  auditable_type String?    @db.VarChar(128)
  auditable_id   BigInt?    @db.UnsignedBigInt
  old_values     Json?
  new_values     Json?
  meta           Json?
  ip             String?    @db.VarChar(45)
  user_agent     String?    @db.Text
  url            String?    @db.VarChar(512)
  created_at     DateTime?  @db.Timestamp(0)
  updated_at     DateTime?  @db.Timestamp(0)
  admin_users    AdminUser? @relation(fields: [actor_admin_id], references: [id], onUpdate: NoAction, map: "audit_logs_actor_admin_id_foreign")
  clients        Client?    @relation(fields: [client_id], references: [id], onUpdate: NoAction, map: "audit_logs_client_id_foreign")
  users          User?      @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "audit_logs_user_id_foreign")

  @@index([actor_admin_id], map: "audit_logs_actor_admin_id_foreign")
  @@index([auditable_type, auditable_id], map: "audit_logs_auditable_type_auditable_id_index")
  @@index([client_id, created_at], map: "audit_logs_client_created_idx")
  @@index([user_id, created_at], map: "audit_logs_user_id_created_at_index")
  @@map("audit_logs")
}

model Cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int

  @@map("cache")
}

model CacheLock {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@map("cache_locks")
}

model CallQueueJob {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  client_id       BigInt       @db.UnsignedBigInt
  campaign_id     BigInt       @db.UnsignedBigInt
  contact_id      BigInt       @db.UnsignedBigInt
  agent_id        BigInt?      @db.UnsignedBigInt
  phone_number_id BigInt?      @db.UnsignedBigInt
  status          String       @default("pending") @db.VarChar(32)
  scheduled_for   DateTime?    @db.Timestamp(0)
  attempts        Int          @default(0) @db.UnsignedTinyInt
  max_retries     Int          @default(3) @db.UnsignedTinyInt
  last_error      String?      @db.Text
  locked_at       DateTime?    @db.Timestamp(0)
  priority        Int          @default(0)
  created_at      DateTime?    @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  agents          Agent?       @relation(fields: [agent_id], references: [id], onUpdate: NoAction, map: "call_queue_jobs_agent_id_foreign")
  campaigns       Campaign     @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "call_queue_jobs_campaign_id_foreign")
  clients         Client       @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "call_queue_jobs_client_id_foreign")
  contacts        Contact      @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "call_queue_jobs_contact_id_foreign")
  phone_numbers   PhoneNumber? @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction, map: "call_queue_jobs_phone_number_id_foreign")

  @@index([agent_id], map: "call_queue_jobs_agent_id_foreign")
  @@index([campaign_id], map: "call_queue_jobs_campaign_id_foreign")
  @@index([client_id], map: "call_queue_jobs_client_id_foreign")
  @@index([contact_id], map: "call_queue_jobs_contact_id_foreign")
  @@index([phone_number_id], map: "call_queue_jobs_phone_number_id_foreign")
  @@index([status, scheduled_for], map: "call_queue_jobs_status_scheduled_for_index")
  @@index([status, scheduled_for], map: "cqj_status_scheduled_idx")
  @@map("call_queue_jobs")
}

model Call {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  client_id        BigInt            @db.UnsignedBigInt
  campaign_id      BigInt?           @db.UnsignedBigInt
  agent_id         BigInt?           @db.UnsignedBigInt
  contact_id       BigInt?           @db.UnsignedBigInt
  phone_number_id  BigInt?           @db.UnsignedBigInt
  twilio_call_sid  String?           @db.VarChar(255)
  direction        String            @default("outbound") @db.VarChar(16)
  engine           String?           @db.VarChar(40)
  status           String            @default("queued") @db.VarChar(32)
  started_at       DateTime?         @db.Timestamp(0)
  ended_at         DateTime?         @db.Timestamp(0)
  duration_seconds Int               @default(0) @db.UnsignedInt
  recording_url    String?           @db.VarChar(255)
  recording_sid    String?           @db.VarChar(255)
  transcript       String?           @db.LongText
  summary          String?           @db.Text
  sentiment        String?           @db.VarChar(16)
  qualification    String?           @db.VarChar(16)
  outcome          String?           @db.VarChar(255)
  voice_cost_cents Int               @default(0) @db.UnsignedInt
  llm_cost_cents   Int               @default(0) @db.UnsignedInt
  credits_charged  Int               @default(0) @db.UnsignedInt
  retry_of         BigInt?           @db.UnsignedBigInt
  meta             Json?
  created_at       DateTime?         @db.Timestamp(0)
  updated_at       DateTime?         @db.Timestamp(0)
  agents           Agent?            @relation(fields: [agent_id], references: [id], onUpdate: NoAction, map: "calls_agent_id_foreign")
  campaigns        Campaign?         @relation(fields: [campaign_id], references: [id], onUpdate: NoAction, map: "calls_campaign_id_foreign")
  clients          Client            @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "calls_client_id_foreign")
  contacts         Contact?          @relation(fields: [contact_id], references: [id], onUpdate: NoAction, map: "calls_contact_id_foreign")
  phone_numbers    PhoneNumber?      @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction, map: "calls_phone_number_id_foreign")
  calls            Call?             @relation("callsTocalls", fields: [retry_of], references: [id], onUpdate: NoAction, map: "calls_retry_of_foreign")
  other_calls      Call[]            @relation("callsTocalls")
  campaign_contact CampaignContact[]
  messages         Message[]

  @@index([agent_id], map: "calls_agent_id_foreign")
  @@index([campaign_id], map: "calls_campaign_id_foreign")
  @@index([client_id, created_at], map: "calls_client_id_created_at_index")
  @@index([client_id, qualification], map: "calls_client_qual_idx")
  @@index([client_id, status], map: "calls_client_status_idx")
  @@index([contact_id], map: "calls_contact_id_foreign")
  @@index([phone_number_id], map: "calls_phone_number_id_foreign")
  @@index([retry_of], map: "calls_retry_of_foreign")
  @@index([twilio_call_sid], map: "calls_twilio_call_sid_index")
  @@map("calls")
}

model CampaignContact {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  campaign_id  BigInt    @db.UnsignedBigInt
  contact_id   BigInt    @db.UnsignedBigInt
  call_status  String    @default("pending") @db.VarChar(32)
  last_call_id BigInt?   @db.UnsignedBigInt
  attempts     Int       @default(0) @db.UnsignedTinyInt
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  campaigns    Campaign  @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "campaign_contact_campaign_id_foreign")
  contacts     Contact   @relation(fields: [contact_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "campaign_contact_contact_id_foreign")
  calls        Call?     @relation(fields: [last_call_id], references: [id], onUpdate: NoAction, map: "campaign_contact_last_call_id_foreign")

  @@unique([campaign_id, contact_id], map: "campaign_contact_campaign_id_contact_id_unique")
  @@index([contact_id], map: "campaign_contact_contact_id_foreign")
  @@index([last_call_id], map: "campaign_contact_last_call_id_foreign")
  @@map("campaign_contact")
}

model Campaign {
  id                  BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  client_id           BigInt            @db.UnsignedBigInt
  user_id             BigInt?           @db.UnsignedBigInt
  name                String            @db.VarChar(255)
  type                String            @default("lead_qualification") @db.VarChar(32)
  goal                String?           @db.Text
  agent_id            BigInt?           @db.UnsignedBigInt
  phone_number_id     BigInt?           @db.UnsignedBigInt
  status              String            @default("draft") @db.VarChar(32)
  schedule_start      DateTime?         @db.Timestamp(0)
  schedule_end        DateTime?         @db.Timestamp(0)
  daily_call_cap      Int?              @db.UnsignedInt
  max_retries         Int               @default(3) @db.UnsignedTinyInt
  retry_delay_minutes Int               @default(60) @db.UnsignedInt
  timezone            String?           @db.VarChar(64)
  stats               Json?
  created_at          DateTime?         @db.Timestamp(0)
  updated_at          DateTime?         @db.Timestamp(0)
  deleted_at          DateTime?         @db.Timestamp(0)
  call_queue_jobs     CallQueueJob[]
  calls               Call[]
  campaign_contact    CampaignContact[]
  agents              Agent?            @relation(fields: [agent_id], references: [id], onUpdate: NoAction, map: "campaigns_agent_id_foreign")
  clients             Client            @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "campaigns_client_id_foreign")
  phone_numbers       PhoneNumber?      @relation(fields: [phone_number_id], references: [id], onUpdate: NoAction, map: "campaigns_phone_number_id_foreign")
  users               User?             @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "campaigns_user_id_foreign")
  webhooks            Webhook[]

  @@index([agent_id], map: "campaigns_agent_id_foreign")
  @@index([client_id, status], map: "campaigns_client_status_idx")
  @@index([phone_number_id], map: "campaigns_phone_number_id_foreign")
  @@index([user_id], map: "campaigns_user_id_foreign")
  @@map("campaigns")
}

model ClientPermission {
  id                     BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  key                    String                 @unique(map: "client_permissions_key_unique") @db.VarChar(255)
  name                   String                 @db.VarChar(255)
  module                 String                 @db.VarChar(64)
  action                 String                 @db.VarChar(16)
  created_at             DateTime?              @db.Timestamp(0)
  updated_at             DateTime?              @db.Timestamp(0)
  client_role_permission ClientRolePermission[]

  @@map("client_permissions")
}

model ClientRolePermission {
  id                   BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  client_role_id       BigInt           @db.UnsignedBigInt
  client_permission_id BigInt           @db.UnsignedBigInt
  client_permissions   ClientPermission @relation(fields: [client_permission_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_role_permission_client_permission_id_foreign")
  client_roles         ClientRole       @relation(fields: [client_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_role_permission_client_role_id_foreign")

  @@unique([client_role_id, client_permission_id], map: "crp_unique")
  @@index([client_permission_id], map: "client_role_permission_client_permission_id_foreign")
  @@map("client_role_permission")
}

model ClientRole {
  id                     BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  client_id              BigInt                 @db.UnsignedBigInt
  key                    String                 @db.VarChar(64)
  name                   String                 @db.VarChar(255)
  is_system              Boolean                @default(false)
  created_at             DateTime?              @db.Timestamp(0)
  updated_at             DateTime?              @db.Timestamp(0)
  client_role_permission ClientRolePermission[]
  clients                Client                 @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_roles_client_id_foreign")
  client_user_role       ClientUserRole[]

  @@unique([client_id, key], map: "client_roles_client_id_key_unique")
  @@map("client_roles")
}

model ClientSubscription {
  id                   BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  client_id            BigInt     @db.UnsignedBigInt
  plan_id              BigInt     @db.UnsignedBigInt
  billing_cycle        String     @db.VarChar(16)
  starts_at            DateTime?  @db.Timestamp(0)
  ends_at              DateTime?  @db.Timestamp(0)
  status               String     @default("active") @db.VarChar(32)
  assigned_by_admin_id BigInt?    @db.UnsignedBigInt
  created_at           DateTime?  @db.Timestamp(0)
  updated_at           DateTime?  @db.Timestamp(0)
  admin_users          AdminUser? @relation(fields: [assigned_by_admin_id], references: [id], onUpdate: NoAction, map: "client_subscriptions_assigned_by_admin_id_foreign")
  clients              Client     @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_subscriptions_client_id_foreign")
  plans                Plan       @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_subscriptions_plan_id_foreign")

  @@index([assigned_by_admin_id], map: "client_subscriptions_assigned_by_admin_id_foreign")
  @@index([client_id, status], map: "client_subscriptions_client_id_status_index")
  @@index([plan_id], map: "client_subscriptions_plan_id_foreign")
  @@map("client_subscriptions")
}

model ClientUserRole {
  id             BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt     @db.UnsignedBigInt
  client_role_id BigInt     @db.UnsignedBigInt
  client_roles   ClientRole @relation(fields: [client_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_user_role_client_role_id_foreign")
  users          User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "client_user_role_user_id_foreign")

  @@unique([user_id, client_role_id], map: "client_user_role_user_id_client_role_id_unique")
  @@index([client_role_id], map: "client_user_role_client_role_id_foreign")
  @@map("client_user_role")
}

model Client {
  id                          BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  name                        String                    @db.VarChar(255)
  email                       String?                   @db.VarChar(255)
  phone                       String?                   @db.VarChar(64)
  address                     String?                   @db.Text
  status                      String                    @default("active") @db.VarChar(32)
  kyc_status                  String                    @default("unverified") @db.VarChar(16)
  base_currency               String                    @default("USD") @db.VarChar(10)
  currency_symbol             String                    @default("$") @db.VarChar(16)
  currency_position           String                    @default("before") @db.VarChar(32)
  created_at                  DateTime?                 @db.Timestamp(0)
  updated_at                  DateTime?                 @db.Timestamp(0)
  agents                      Agent[]
  api_audit_logs              ApiAuditLog[]
  api_keys                    ApiKey[]
  appointments                Appointment[]
  audit_logs                  AuditLog[]
  call_queue_jobs             CallQueueJob[]
  calls                       Call[]
  campaigns                   Campaign[]
  client_roles                ClientRole[]
  client_subscriptions        ClientSubscription[]
  contact_lists               ContactList[]
  contacts                    Contact[]
  conversations               Conversation[]
  credit_ledger               CreditLedger[]
  credit_purchases            CreditPurchase[]
  customer_support_tickets    CustomerSupportTicket[]
  flow_executions             FlowExecution[]
  flows                       Flow[]
  form_submissions            FormSubmission[]
  forms                       Form[]
  google_sheet_connections    GoogleSheetConnection?
  inbound_routes              InboundRoute[]
  knowledge_base_items        KnowledgeBaseItem[]
