# Copy to /opt/callmine/.env; replace EVERY REPLACE_* value before use.
# Use a URL-encoded password inside DATABASE_URL.
NODE_ENV=production
APP_ENV=production
APP_NAME="CallMineAI"
APP_URL="https://calls.example.com"
NEXT_PUBLIC_APP_NAME="CallMineAI"
NEXT_PUBLIC_APP_URL="https://calls.example.com"
APP_DEBUG=false
APP_DEMO_MODE=false
APP_INSTALLED=true
DATABASE_URL="mysql://callmine:REPLACE_URL_ENCODED_DB_PASSWORD@127.0.0.1:3306/callmine"
AUTH_SECRET="REPLACE_RANDOM_SECRET"
APP_KEY="REPLACE_WITH_GENERATED_APP_KEY"
CRON_SECRET="REPLACE_DIFFERENT_RANDOM_SECRET"

TELEPHONY_PROVIDER=twilio
TWILIO_ENABLED=true
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_DEFAULT_FROM=""
TWILIO_INBOUND_VOICE_URL="https://calls.example.com/webhooks/twilio/voice"
TWILIO_STATUS_CALLBACK_URL="https://calls.example.com/webhooks/twilio/status"
TWILIO_RECORDING_CALLBACK_URL="https://calls.example.com/webhooks/twilio/recording"
PLIVO_ENABLED=false

AI_PROVIDER=openai
AI_OPENAI_ENABLED=true
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
CALL_DEFAULT_LLM=gpt-4o-mini
CALL_DEFAULT_ENGINE=openai_twilio
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID=""

MAIL_HOST=""
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION=tls
MAIL_ALLOW_SELF_SIGNED=false
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="CallMineAI"

WHATSAPP_PROVIDER_MODE=disabled
BILLING_STRIPE_ENABLED=false
BILLING_PAYPAL_ENABLED=false
BILLING_PADDLE_ENABLED=false

# New database only: these create the initial accounts. Use real owner emails
# and different strong passwords; no vendor demo passwords in production.
ADMIN_SEED_EMAIL="REPLACE_ADMIN_EMAIL"
ADMIN_SEED_PASSWORD="REPLACE_STRONG_ADMIN_PASSWORD"
CLIENT_SEED_EMAIL="REPLACE_INITIAL_CLIENT_EMAIL"
CLIENT_SEED_PASSWORD="REPLACE_DIFFERENT_STRONG_CLIENT_PASSWORD"
